<?xml version="1.0" encoding="utf-8"?>
<!--
    Plantilla de secrets.config (este archivo SI se sube al repo, sin valores).

    Como usarlo:
      1. Copiar este archivo en la misma carpeta con el nombre secrets.config
      2. Completar los valores (se piden por privado al equipo, NUNCA por el repo).
    secrets.config esta en .gitignore: no se sube. Web.config lo lee con <appSettings file="secrets.config">.
-->
<appSettings>
  <!-- Correo (contraseña de aplicacion de la cuenta de Gmail del proyecto) -->
  <add key="Email.Clave" value="" />

  <!-- Asistente IA -->
  <add key="Gemini.ApiKey" value="" />
  <add key="Gemini.Modelo" value="" />

  <!-- URL publica de la app, sin barra final. En desarrollo: la URL de ngrok,
       por ejemplo https://xxxx.ngrok-free.dev . La usan los links de los mails
       y Mercado Pago (vuelta del pago y webhook). Si queda vacia, se usa la URL del request. -->
  <add key="App.UrlBase" value="" />

  <!-- Mercado Pago: Access Token de las credenciales de PRUEBA (empieza con APP_USR-) -->
  <add key="MercadoPago.AccessToken" value="" />
</appSettings>
