<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="MediStack.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> | MediStack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="<%: ResolveUrl("~/Content/site.css") %>?v=<%: System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/site.css")).Ticks %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    <link href="<%: ResolveUrl("~/Content/accesibilidad.css") %>?v=<%: System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/accesibilidad.css")).Ticks %>" rel="stylesheet" />
    <script src="<%: ResolveUrl("~/Scripts/accesibilidad.js") %>?v=<%: System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/accesibilidad.js")).Ticks %>"></script>
    <script src="<%: ResolveUrl("~/Scripts/sidebar.js") %>?v=<%: System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/sidebar.js")).Ticks %>"></script>
</head>
<body>
    <form id="MainForm" runat="server">
        <a class="skip-link" href="#main-content">Saltar al contenido</a>
        <div class="ms-visual-bar">
            <details id="ms-ajustes-visuales">
                <summary id="ms-ajustes-resumen" class="ms-visual-summary" aria-label="Abrir ajustes de accesibilidad" title="Ajustes de accesibilidad">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="12" cy="12" r="10" />
                        <circle cx="12" cy="7.2" r="1.2" fill="currentColor" />
                        <path d="M7 10.6c3.3 1 6.7 1 10 0" />
                        <path d="M12 11v3.2" />
                        <path d="m9.6 18 2.4-3.8 2.4 3.8" />
                    </svg>
                </summary>
                <div class="ms-visual-panel" role="region" aria-labelledby="ms-ajustes-titulo">
                    <div class="ms-visual-top">
                        <div>
                            <h2 id="ms-ajustes-titulo" class="ms-visual-title">Accesibilidad visual</h2>
                            <p class="ms-visual-subtitle">Ajustá la lectura, el texto y la navegación.</p>
                        </div>
                        <button type="button" id="ms-ajustes-cerrar" class="ms-visual-close" aria-label="Cerrar ajustes">&#215;</button>
                    </div>
                    <fieldset id="ms-ajustes-opciones" class="ms-visual-options" disabled>
                        <legend class="ms-visual-legend">Preferencias de accesibilidad</legend>
                        <section class="ms-visual-section" aria-labelledby="ms-lectura-titulo">
                            <h3 id="ms-lectura-titulo" class="ms-visual-section-title">Lectura y tipografía</h3>
                            <div class="ms-visual-group">
                                <div class="ms-visual-label-line">
                                    <label for="ms-tamano-texto">Tamaño del texto</label>
                                    <output id="ms-tamano-valor" for="ms-tamano-texto">100 %</output>
                                </div>
                                <input id="ms-tamano-texto" class="ms-visual-range" type="range" min="100" max="200" step="10" value="100" />
                            </div>
                            <div class="ms-visual-group">
                                <label for="ms-fuente">Tipo de letra</label>
                                <select id="ms-fuente" class="form-control">
                                    <option value="original">Original</option>
                                    <option value="sans">Sin serifas</option>
                                    <option value="serif">Con serifas</option>
                                </select>
                            </div>
                            <div class="ms-visual-group">
                                <div class="ms-visual-label-line">
                                    <label for="ms-interlineado">Altura de línea</label>
                                    <output id="ms-interlineado-valor" for="ms-interlineado">1,5</output>
                                </div>
                                <input id="ms-interlineado" class="ms-visual-range" type="range" min="1.5" max="2" step="0.1" value="1.5" />
                            </div>
                            <div class="ms-visual-group">
                                <div class="ms-visual-label-line">
                                    <label for="ms-espaciado-letras">Espaciado entre letras</label>
                                    <output id="ms-letras-valor" for="ms-espaciado-letras">0 px</output>
                                </div>
                                <input id="ms-espaciado-letras" class="ms-visual-range" type="range" min="0" max="2" step="0.5" value="0" />
                            </div>
                            <div class="ms-visual-group">
                                <label for="ms-ancho-parrafo">Ancho de lectura</label>
                                <select id="ms-ancho-parrafo" class="form-control">
                                    <option value="normal">Original</option>
                                    <option value="estrecho">Estrecho</option>
                                    <option value="amplio">Amplio</option>
                                </select>
                            </div>
                            <label class="ms-visual-check" for="ms-texto-negrita">
                                <input type="checkbox" id="ms-texto-negrita" />
                                Texto más destacado
                            </label>
                        </section>
                        <section class="ms-visual-section" aria-labelledby="ms-apariencia-titulo">
                            <h3 id="ms-apariencia-titulo" class="ms-visual-section-title">Apariencia y navegación</h3>
                            <label class="ms-visual-check" for="ms-alto-contraste">
                                <input type="checkbox" id="ms-alto-contraste" />
                                Alto contraste
                            </label>
                            <label class="ms-visual-check" for="ms-resaltar-enlaces">
                                <input type="checkbox" id="ms-resaltar-enlaces" />
                                Destacar enlaces y foco
                            </label>
                            <label class="ms-visual-check" for="ms-reducir-movimiento">
                                <input type="checkbox" id="ms-reducir-movimiento" />
                                Reducir animaciones
                            </label>
                        </section>
                        <button type="button" id="ms-restablecer" class="button button-light ms-visual-reset">Restablecer todos los ajustes</button>
                    </fieldset>
                    <p id="ms-ajustes-estado" class="ms-visual-status" role="status" aria-live="polite" aria-atomic="true">Cargando ajustes de visualización.</p>
                    <noscript><p>Activá JavaScript para usar estos ajustes. También podés ampliar la página desde el navegador.</p></noscript>
                </div>
            </details>
        </div>
        <div class="app-shell" id="appShell" runat="server">
            <asp:PlaceHolder ID="SidebarHolder" runat="server" Visible="false">
                <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
                <aside class="app-sidebar" id="appSidebar" aria-label="Navegación principal">
                    <div class="sidebar-header">
                        <a class="sidebar-brand" href="<%: ResolveUrl("~/Dashboard.aspx") %>" aria-label="MediStack, inicio">
                            <img class="brand-logo" src="<%: ResolveUrl("~/Content/MediStack-logo-violeta.png") %>" alt="MediStack" />
                            <span class="brand-compact-mark">MS</span>
                        </a>
                        <button type="button" class="sidebar-collapse-btn" id="sidebarCollapseBtn" title="Alternar menú lateral" aria-label="Alternar menú lateral">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="sidebar-toggle-icon">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="9" y1="3" x2="9" y2="21"></line>
                                <path d="m14 9-3 3 3 3"></path>
                            </svg>
                        </button>
                    </div>

                    <div class="sidebar-scrollable">
                        <asp:Panel ID="NavegacionAdministrativa" runat="server" CssClass="sidebar-nav-panel" Visible="false">
                            <nav class="sidebar-nav" aria-label="Gestión de la clínica">
                                <div class="sidebar-section-title"><span>Operación Diaria</span></div>
                                <a href="<%: ResolveUrl("~/Pacientes.aspx") %>" class="sidebar-nav-link" data-title="Pacientes"><span>Pacientes</span></a>
                                <a href="<%: ResolveUrl("~/Turnos.aspx") %>" class="sidebar-nav-link" data-title="Turnos"><span>Turnos</span></a>
                                <a href="<%: ResolveUrl("~/Cobros.aspx") %>" class="sidebar-nav-link" data-title="Cobros"><span>Cobros</span></a>
                                <a href="<%: ResolveUrl("~/Caja.aspx") %>" class="sidebar-nav-link" data-title="Caja"><span>Caja</span></a>
                                <a href="<%: ResolveUrl("~/RevisionDia.aspx") %>" class="sidebar-nav-link" data-title="Recepción del día"><span>Recepción del día</span></a>

                                <div class="sidebar-section-title"><span>Gestión y Seguimiento</span></div>
                                <a href="<%: ResolveUrl("~/Agenda.aspx") %>" class="sidebar-nav-link" data-title="Agendas"><span>Agendas</span></a>
                                <a href="<%: ResolveUrl("~/Reembolsos.aspx") %>" class="sidebar-nav-link" data-title="Reembolsos"><span>Reembolsos</span></a>
                                <a href="<%: ResolveUrl("~/Liquidaciones.aspx") %>" class="sidebar-nav-link" data-title="Honorarios"><span>Honorarios</span></a>
                                <a href="<%: ResolveUrl("~/Reportes.aspx") %>" class="sidebar-nav-link" data-title="Reportes"><span>Reportes</span></a>
                                <a href="<%: ResolveUrl("~/AsistentePaciente.aspx") %>" class="sidebar-nav-link" data-title="Asistente"><span>Asistente</span></a>

                                <details class="sidebar-accordion" id="sidebarCatalogos">
                                    <summary class="sidebar-accordion-summary" title="Catálogos y ajustes">
                                        <span class="sidebar-accordion-icon" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="3"></circle>
                                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                            </svg>
                                        </span>
                                        <span class="sidebar-accordion-label">Catálogos y Ajustes</span>
                                        <svg class="sidebar-accordion-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polyline points="6 9 12 15 18 9"></polyline>
                                        </svg>
                                    </summary>
                                    <div class="sidebar-accordion-content">
                                        <a href="<%: ResolveUrl("~/Profesionales.aspx") %>" class="sidebar-nav-link" data-title="Profesionales"><span>Profesionales</span></a>
                                        <a href="<%: ResolveUrl("~/Especialidades.aspx") %>" class="sidebar-nav-link" data-title="Especialidades"><span>Especialidades</span></a>
                                        <a href="<%: ResolveUrl("~/ObrasSociales.aspx") %>" class="sidebar-nav-link" data-title="Obras sociales"><span>Obras sociales</span></a>
                                        <a href="<%: ResolveUrl("~/Coberturas.aspx") %>" class="sidebar-nav-link" data-title="Coberturas"><span>Coberturas</span></a>
                                        <a href="<%: ResolveUrl("~/Convenios.aspx") %>" class="sidebar-nav-link" data-title="Convenios"><span>Convenios</span></a>
                                        <a href="<%: ResolveUrl("~/UsuariosBloqueados.aspx") %>" class="sidebar-nav-link" data-title="Usuarios bloqueados"><span>Usuarios bloqueados</span></a>
                                    </div>
                                </details>
                            </nav>
                        </asp:Panel>

                        <asp:Panel ID="NavegacionPaciente" runat="server" CssClass="sidebar-nav-panel" Visible="false">
                            <nav class="sidebar-nav" aria-label="Mi cuenta de paciente">
                                <div class="sidebar-section-title"><span>Mis Servicios</span></div>
                                <a href="<%: ResolveUrl("~/Turnos.aspx") %>" class="sidebar-nav-link" data-title="Mis turnos"><span>Mis turnos</span></a>
                                <a href="<%: ResolveUrl("~/Turnos.aspx?vista=solicitar") %>#solicitar-turno-title" class="sidebar-nav-link" data-title="Solicitar turno"><span>Solicitar turno</span></a>
                                <a href="<%: ResolveUrl("~/AsistentePaciente.aspx") %>" class="sidebar-nav-link" data-title="Asistente de turnos"><span>Asistente de turnos</span></a>
                                <a href="<%: ResolveUrl("~/Cobros.aspx") %>" class="sidebar-nav-link" data-title="Mis cobros"><span>Mis cobros</span></a>
                            </nav>
                        </asp:Panel>

                        <asp:Panel ID="NavegacionProfesional" runat="server" CssClass="sidebar-nav-panel" Visible="false">
                            <nav class="sidebar-nav" aria-label="Mi actividad profesional">
                                <div class="sidebar-section-title"><span>Atención Médica</span></div>
                                <a href="<%: ResolveUrl("~/Agenda.aspx") %>" class="sidebar-nav-link" data-title="Mi agenda"><span>Mi agenda</span></a>
                                <a href="<%: ResolveUrl("~/Turnos.aspx") %>" class="sidebar-nav-link" data-title="Turnos"><span>Turnos</span></a>
                                <a href="<%: ResolveUrl("~/Cobros.aspx") %>" class="sidebar-nav-link" data-title="Cobros"><span>Cobros</span></a>
                                <a href="<%: ResolveUrl("~/AsistentePaciente.aspx") %>" class="sidebar-nav-link" data-title="Asistente"><span>Asistente</span></a>
                            </nav>
                        </asp:Panel>
                    </div>

                    <div class="sidebar-user-footer">
                        <div class="sidebar-user-card">
                            <asp:PlaceHolder ID="PhAvatarPaciente" runat="server" Visible="false">
                                <a href="<%: ResolveUrl("~/FichaPaciente.aspx") %>" class="user-avatar user-avatar-link" title="Mi ficha médica" aria-label="Mi ficha médica">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="avatar-svg">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                </a>
                            </asp:PlaceHolder>
                            <asp:PlaceHolder ID="PhAvatarGeneral" runat="server" Visible="true">
                                <div class="user-avatar" title="Usuario activo">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="avatar-svg">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                </div>
                            </asp:PlaceHolder>
                            <a class="sidebar-user-meta" href="<%: ResolveUrl("~/MiCuenta.aspx") %>" title="Mi cuenta">
    <span class="sidebar-user-name"><asp:Literal ID="NombreActual" runat="server" /></span>
    <span class="sidebar-user-role"><asp:Literal ID="RolActual" runat="server" /></span>
</a>
                            <a class="sidebar-logout-btn" href="<%: ResolveUrl("~/Salir.aspx") %>" title="Cerrar sesión" aria-label="Cerrar sesión">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                    <polyline points="16 17 21 12 16 7" />
                                    <line x1="21" y1="12" x2="9" y2="12" />
                                </svg>
                            </a>
                        </div>
                    </div>

                    <div class="sidebar-resizer" id="sidebarResizer" title="Arrastrar para ajustar ancho"></div>
                </aside>
            </asp:PlaceHolder>

            <div class="app-main-area">
                <asp:PlaceHolder ID="TopbarAutenticado" runat="server" Visible="false">
                    <header class="app-topbar">
                        <div class="topbar-left">
                            <button type="button" class="topbar-menu-btn" id="topbarMenuBtn" title="Abrir menú" aria-label="Abrir menú" aria-controls="appSidebar" aria-expanded="false">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="3" y1="12" x2="21" y2="12"></line>
                                    <line x1="3" y1="6" x2="21" y2="6"></line>
                                    <line x1="3" y1="18" x2="21" y2="18"></line>
                                </svg>
                            </button>
                            <div class="topbar-page-info">
                                <span class="topbar-clinic-badge">MediStack</span>
                                <h1 class="topbar-page-title"><%: Page.Title %></h1>
                            </div>
                        </div>
                        <div class="topbar-right">
                            <a class="topbar-action-btn" href="<%: ResolveUrl("~/Dashboard.aspx") %>" title="Ir a Inicio" aria-label="Ir a Inicio">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                                    <polyline points="9 22 9 12 15 12 15 22" />
                                </svg>
                            </a>
                            <asp:PlaceHolder ID="PhMiFicha" runat="server" Visible="false">
                                <a class="topbar-action-btn" href="<%: ResolveUrl("~/FichaPaciente.aspx") %>" title="Mi ficha médica" aria-label="Mi ficha médica">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                                        <rect x="8" y="2" width="8" height="4" rx="1" />
                                        <circle cx="12" cy="11" r="2" />
                                        <path d="M8 17a4 4 0 0 1 8 0" />
                                    </svg>
                                </a>
                            </asp:PlaceHolder>
                        </div>
                    </header>
                </asp:PlaceHolder>

                <asp:PlaceHolder ID="HeaderAnonimo" runat="server" Visible="false">
                    <header class="site-header">
                        <a class="brand" href="<%: ResolveUrl("~/Default.aspx") %>" aria-label="MediStack, inicio">
                            <img class="brand-logo" height="44" style="height:44px;width:auto" src="<%: ResolveUrl("~/Content/MediStack-logo-violeta.png") %>" alt="MediStack" />
                        </a>
                        <nav class="user-nav" aria-label="Cuenta">
                            <div class="anon-nav">
                                <a class="anon-login-link" href="<%: ResolveUrl("~/Account/Login.aspx") %>">Ingresar</a>
                                <a class="button button-primary button-sm" href="<%: ResolveUrl("~/Account/Registro.aspx") %>">Crear cuenta</a>
                            </div>
                        </nav>
                    </header>
                </asp:PlaceHolder>

                <main id="main-content" class="main-container" tabindex="-1">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>

                <footer class="site-footer">
                    <p>MediStack · Gestión clínica</p>
                </footer>
            </div>
        </div>
    </form>
</body>
</html>
