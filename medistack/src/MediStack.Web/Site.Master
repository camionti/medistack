<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="MediStack.Web.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%: Page.Title %> | MediStack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="<%: ResolveUrl("~/Content/site.css") %>?v=<%: System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/site.css")).Ticks %>" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
    <link href="<%: ResolveUrl("~/Content/accesibilidad.css") %>?v=1" rel="stylesheet" />
    <script src="<%: ResolveUrl("~/Scripts/accesibilidad.js") %>?v=1"></script>
</head>
<body>
    <form id="MainForm" runat="server">
        <a class="skip-link" href="#main-content">Saltar al contenido</a>
        <div class="ms-visual-bar">
            <details id="ms-ajustes-visuales">
                <summary id="ms-ajustes-resumen" class="ms-visual-summary" aria-label="Abrir ajustes de accesibilidad" title="Ajustes de accesibilidad">
                    <svg viewBox="0 0 48 48" aria-hidden="true" focusable="false" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="24" cy="8" r="4.5" fill="currentColor" />
                        <path d="M10 18H38M24 18V40M24 27L14 43M24 27L34 43" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </summary>
                <div class="ms-visual-panel" role="region" aria-labelledby="ms-ajustes-titulo">
                    <div class="ms-visual-top">
                        <div>
                            <h2 id="ms-ajustes-titulo" class="ms-visual-title">Accesibilidad visual</h2>
                            <p class="ms-visual-subtitle">Personalizá cómo se ve MediStack.</p>
                        </div>
                        <button type="button" id="ms-ajustes-cerrar" class="ms-visual-close" aria-label="Cerrar ajustes">&#215;</button>
                    </div>
                    <fieldset id="ms-ajustes-opciones" class="ms-visual-options" disabled>
                        <legend class="ms-visual-legend">Preferencias visuales</legend>
                        <div class="ms-visual-group">
                            <label for="ms-tamano-texto">Tamaño del texto</label>
                            <select id="ms-tamano-texto" class="form-control">
                                <option value="normal">100 %</option>
                                <option value="grande">150 %</option>
                                <option value="muy-grande">200 %</option>
                            </select>
                        </div>
                        <label class="ms-visual-check" for="ms-alto-contraste">
                            <input type="checkbox" id="ms-alto-contraste" />
                            Alto contraste
                        </label>
                        <button type="button" id="ms-restablecer" class="button button-light ms-visual-reset">Restablecer apariencia</button>
                    </fieldset>
                    <p id="ms-ajustes-estado" class="ms-visual-status" role="status" aria-live="polite" aria-atomic="true">Cargando ajustes de visualización.</p>
                    <noscript><p>Activá JavaScript para usar estos ajustes. También podés ampliar la página desde el navegador.</p></noscript>
                </div>
            </details>
        </div>
        <header class="site-header">
            <a class="brand" href="<%: ResolveUrl("~/Dashboard.aspx") %>" aria-label="MediStack, inicio">
                <img class="brand-logo" height="44" style="height:44px;width:auto" src="<%: ResolveUrl("~/Content/MediStack-logo-violeta.png") %>" alt="MediStack" />
            </a>
            <nav class="user-nav" aria-label="Cuenta">
                <asp:PlaceHolder ID="UsuarioActual" runat="server" Visible="false">
                    <span class="user-summary">
                        <asp:Literal ID="NombreActual" runat="server" />
                        <span class="user-role"><asp:Literal ID="RolActual" runat="server" /></span>
                    </span>
                    <a class="logout-link" href="<%: ResolveUrl("~/Salir.aspx") %>">Cerrar sesión</a>
                </asp:PlaceHolder>
            </nav>
        </header>
        <asp:Panel ID="NavegacionAdministrativa" runat="server" CssClass="admin-nav" Visible="false">
            <nav class="admin-nav-inner" aria-label="Gestión de la clínica">
                <a href="<%: ResolveUrl("~/Dashboard.aspx") %>">Inicio</a>
                <a href="<%: ResolveUrl("~/Pacientes.aspx") %>">Pacientes</a>
                <a href="<%: ResolveUrl("~/Turnos.aspx") %>">Turnos</a>
                <a href="<%: ResolveUrl("~/Cobros.aspx") %>">Cobros</a>
                <a href="<%: ResolveUrl("~/Caja.aspx") %>">Caja</a>
                <a href="<%: ResolveUrl("~/Agenda.aspx") %>">Agendas</a>
                <a href="<%: ResolveUrl("~/Profesionales.aspx") %>">Profesionales</a>
                <a href="<%: ResolveUrl("~/Especialidades.aspx") %>">Especialidades</a>
                <a href="<%: ResolveUrl("~/ObrasSociales.aspx") %>">Obras sociales</a>
                <a href="<%: ResolveUrl("~/Coberturas.aspx") %>">Coberturas</a>
                <a href="<%: ResolveUrl("~/Convenios.aspx") %>">Convenios</a>
            </nav>
        </asp:Panel>
        <asp:Panel ID="NavegacionPaciente" runat="server" CssClass="admin-nav" Visible="false">
            <nav class="admin-nav-inner" aria-label="Mi cuenta de paciente">
                <a href="<%: ResolveUrl("~/Dashboard.aspx") %>">Inicio</a>
                <a href="<%: ResolveUrl("~/Turnos.aspx") %>">Mis turnos</a>
                <a href="<%: ResolveUrl("~/Turnos.aspx") %>#solicitar-turno-title">Solicitar turno</a>
                <a href="<%: ResolveUrl("~/FichaPaciente.aspx") %>">Mi ficha</a>
                <a href="<%: ResolveUrl("~/Cobros.aspx") %>">Mis cobros</a>
            </nav>
        </asp:Panel>
        <asp:Panel ID="NavegacionProfesional" runat="server" CssClass="admin-nav" Visible="false">
            <nav class="admin-nav-inner" aria-label="Mi actividad profesional">
                <a href="<%: ResolveUrl("~/Dashboard.aspx") %>">Inicio</a>
                <a href="<%: ResolveUrl("~/Agenda.aspx") %>">Mi agenda</a>
                <a href="<%: ResolveUrl("~/Turnos.aspx") %>">Turnos</a>
                <a href="<%: ResolveUrl("~/Cobros.aspx") %>">Cobros</a>
            </nav>
        </asp:Panel>
        <main id="main-content" class="main-container" tabindex="-1">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </main>
        <footer class="site-footer">
            <p>MediStack · Gestión clínica</p>
        </footer>
    </form>
</body>
</html>
